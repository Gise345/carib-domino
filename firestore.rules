rules_version = '2';

// Default-deny baseline.
//
// Every Firestore collection in this project must be explicitly allowed below.
// Until a collection has its own rule, all client reads and writes are denied.
//
// Trust model reminder (see docs/ARCHITECTURE.md §4):
//   - Wallets, ELO, stats, entitlements, match results: writes ONLY via Cloud
//     Functions using the Admin SDK (which bypasses these rules). Clients may
//     read their own where applicable; never write.
//   - Per-user documents: ownership checked against `request.auth.uid`, never
//     against fields stored in the document.
//   - Add a per-collection match block for every new collection introduced.
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // /users/{userId} — player profile (display name, locale, country, etc.)
    //
    // Self-describing data the player controls: display name, locale, country
    // hint, timestamps. One of the few client-writable paths in the project.
    // Wallet, ELO, stats, and entitlement data are NOT on this document — they
    // live in separate collections that remain Cloud-Functions-only.
    //
    // Both read and write are restricted to the document owner. The owner is
    // identified by the document ID matching `request.auth.uid` — never by a
    // field on the document itself (per trust model bullet 2 above).
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // -----------------------------------------------------------------------
    // /stats/{userId} — per-player aggregate stats (wins, losses, draws, etc.)
    //
    // Read-own only; writes are Cloud-Functions-only (Admin SDK bypasses
    // rules). The settlement Cloud Function `submitMatchResult` is the only
    // path through which this document ever updates — clients submit a round
    // result, the function increments counters atomically. M4's replay
    // validator will additionally verify the claimed outcome before writing.
    // -----------------------------------------------------------------------
    match /stats/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // /matches/{matchId} — per-round server-issued seed record (M4.2).
    //
    // Written only by the `startMatch` Cloud Function (Admin SDK) and read only
    // by the settlement function at replay time. The seed reaches clients
    // through startMatch's return value, never by reading this doc — so clients
    // have no read or write access at all. This is what makes the seed
    // unguessable/unpickable by a client (ADR 0007).
    // -----------------------------------------------------------------------
    match /matches/{matchId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // /wallets/{userId} — coin balance (M6). Server-authoritative money: only
    // Cloud Functions (Admin SDK) ever write it — staking an entry, paying a
    // pot out. A player may READ their OWN balance (the client shows it in the
    // header), but never write it and never read anyone else's. ADR 0016.
    // -----------------------------------------------------------------------
    match /wallets/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // /inviteRewards/{userId} — daily Facebook-invite reward ledger (M7): the
    // per-day count + rewarded invite ids that cap the +250-coin reward. Written
    // and read only by the claimInviteReward Cloud Function (Admin SDK); the
    // client never touches it, so the cap can't be bypassed. ADR 0017.
    // -----------------------------------------------------------------------
    match /inviteRewards/{userId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // /facebookIndex/{facebookId} — server-only fbId -> uid map (M7). Written by
    // syncFacebookIdentity (Admin SDK) from the caller's VERIFIED auth-token
    // Facebook id, and read by resolveFacebookFriends to turn a friend's
    // Facebook id into an app player. Denied to clients entirely: it must not be
    // client-writable (a spoofed fbId could hijack another player's friend links)
    // and must not be client-readable (the friend graph must not be scrapeable).
    // ADR 0019.
    // -----------------------------------------------------------------------
    match /facebookIndex/{facebookId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // /series/{seriesId} — server-side match series (M6): roster (seat -> the
    // player's own authenticated uid), pot, and running team-points. Written
    // and read only by Cloud Functions (openSeries / joinSeries / settlement);
    // the seriesId reaches clients through openSeries' return value. Holding the
    // roster server-side is what makes result->uid attribution trustworthy
    // (closes the ADR 0007 gap). No client access at all. ADR 0016.
    // -----------------------------------------------------------------------
    match /series/{seriesId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // /testerSignups/{hash} — soft-launch tester signups from the marketing
    // site (caribbeandominos.com). ADR 0009.
    //
    // Written only by the `testerSignup` Cloud Function (Admin SDK), keyed by
    // sha256 of the normalised email so a repeat submission merges instead of
    // taking a second seat. The web form has no Firebase SDK and no Firestore
    // credentials at all — it POSTs to the function through a Hosting rewrite.
    // Nothing here is ever client-readable: the collection holds contact
    // details for real people.
    // -----------------------------------------------------------------------
    match /testerSignups/{signupId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Admin subsystem (ADR 0022) — all server-only. Admin powers run through
    // admin Cloud Functions (Admin SDK) that verify the `admin` custom claim AND
    // re-check the server-side email allowlist; nothing here is client-writable,
    // and admin reads also go through callables so every access is controlled and
    // audited. Denying the client entirely keeps the moderation/economy surface
    // off the device.
    //   /adminAudit    — immutable who/what/when log of every admin action
    //   /bans          — banned uids + reason (enforced by gameplay functions)
    //   /promotions    — promo definitions (applied server-side)
    //   /adminStats    — precomputed analytics aggregates
    // -----------------------------------------------------------------------
    match /adminAudit/{entryId} {
      allow read, write: if false;
    }
    match /bans/{userId} {
      allow read, write: if false;
    }
    match /promotions/{promoId} {
      allow read, write: if false;
    }
    match /promoRedemptions/{redemptionId} {
      allow read, write: if false;
    }
    match /adminStats/{docId} {
      allow read, write: if false;
    }

    // Default deny — collections without an explicit match block above are
    // fully denied. Add a new match block here whenever a new collection
    // gets introduced.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
